# ---- Supabase (solo servidor) ----
# El navegador ya NO usa claves de Supabase: todo pasa por server.ts.
SUPABASE_URL="https://<tu-proyecto>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""          # Obligatoria. Nunca exponerla al cliente.

# ---- Sesión ----
# Cadena aleatoria de 32+ caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# ---- Gemini (asesoría laboral, solo Gerencia) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ---- Integraciones POS (servidor) ----
JUSTO_API_TOKEN=""
INTUIPOS_TOKEN=""
# Solo si un local no tiene intuipos_store_id en la tabla locales:
INTUIPOS_STORE_ID=""

PORT=3000

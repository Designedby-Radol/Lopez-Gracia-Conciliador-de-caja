rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Master Gate / Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers globales de validación
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validación estricta del esquema de CierreCaja
    function isValidCierreCaja(data) {
      return data.fecha is string 
        && data.fecha.size() == 10 
        && data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.efectivoCierre is number
        && data.efectivoCierre >= 0
        && data.datafonoCierre is number
        && data.datafonoCierre >= 0
        && data.justoCierre is number
        && data.justoCierre >= 0
        && data.rappiCierre is number
        && data.rappiCierre >= 0
        && data.propinas is number
        && data.propinas >= 0
        && data.novedades is string
        && data.novedades.size() <= 2000
        && data.estado is string
        && (data.estado == 'Pendiente por Cuadrar' || data.estado == 'Cuadrado');
    }

    // Reglas para la colección de cierres de caja
    match /cierres_caja/{cierreId} {
      // Permitir listar y leer si el usuario está autenticado
      allow read, list: if isSignedIn();

      // Permitir creación si está autenticado, tiene un ID válido y el esquema es correcto
      allow create: if isSignedIn() 
        && isValidId(cierreId) 
        && isValidCierreCaja(incoming())
        && incoming().estado == 'Pendiente por Cuadrar';

      // Permitir actualizaciones si está autenticado, el esquema final es válido, 
      // e implementa el patrón de actualización por campos específicos (p. ej., auditar o conciliar)
      allow update: if isSignedIn()
        && isValidCierreCaja(incoming())
        && (
          // El propietario o auditor puede actualizar solo si estaba pendiente
          existing().estado == 'Pendiente por Cuadrar'
          && incoming().diff(existing()).affectedKeys().hasAny([
            'efectivoPOS', 'tarjetasPOS', 'justoPOS', 'rappiPOS',
            'difEfectivo', 'difTarjetas', 'difJusto', 'difRappi',
            'estado', 'auditadoPor', 'auditadoAt'
          ])
        );

      // Bloquear borrado para proteger integridad contable
      allow delete: if false;
    }
  }
}
